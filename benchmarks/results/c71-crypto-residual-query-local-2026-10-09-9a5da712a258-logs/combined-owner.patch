+                        else { expected0=oracle::mul(value,lower); expected2=oracle::sub(oracle::E{},oracle::mul(value,oracle::sub(upper,lower))); }
+                        assert(same(actual.value[0],expected0) && same(actual.value[1],expected2)); ++algebra;
