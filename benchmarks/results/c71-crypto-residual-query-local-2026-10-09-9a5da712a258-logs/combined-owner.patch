+                residual_oracle::fold(residual_oracle::fold(values[0],values[2],r0),residual_oracle::fold(values[1],values[3],r0),r1);
+            output.c0[i]=value.c0; output.c1[i]=value.c1; output.c2[i]=value.c2;
